# Copy to .env and fill in. .env and .env.local are gitignored.

# Set to "false" to call the real APIs instead of mock data.
VITE_USE_MOCKS=true

# CTA Train Tracker API — arrival predictions, train positions.
# Request at https://www.transitchicago.com/developers/traintrackerapply/
# OPTIONAL: the app's core (elevator status, station verdicts) works without this.
# Used only for arrival-time features like haptic "your stop is next" alerts.
# Server-side only (no VITE_ prefix): the Vite dev proxy injects it.
CTA_TRAIN_KEY=

# CTA Bus Tracker API — bus predictions, crowding (psgld).
# Request at https://www.transitchicago.com/developers/bustracker/
# OPTIONAL: only needed if we add the bus companion features.
CTA_BUS_KEY=

# Google Maps Platform — Map Tiles API (satellite) + Street View Static API.
# OPTIONAL: without it the map and Street View show placeholders.
# Exposed to the browser, so restrict it by HTTP referrer in Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# NOTE: the Customer Alerts API (elevator outages) and Route Status API need
# NO KEY. Neither does static GTFS. The accessibility-critical data is all open.
